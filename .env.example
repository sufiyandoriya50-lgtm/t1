
# ==========================================
# FLOODSHIELD BACKEND CONFIGURATION
# ==========================================

# Application environment
# development = local testing
# production = live server
APP_ENV=development

# Security keys
# Replace these placeholders with long, random values.
# Never use your real production keys in this example file.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# Database connection
# Default local database (SQLite).
# For production, configure your PostgreSQL connection URL.
DATABASE_URL=sqlite:///floodshield.db

# Rate limiting storage
# memory:// is suitable for local development.
# Use Redis for production and multiple server instances.
RATELIMIT_STORAGE_URI=memory://

# ==========================================
# GOOGLE SIGN-IN
# ==========================================

# OAuth client ID used to verify Google Sign-In tokens.
GOOGLE_CLIENT_ID=

# ==========================================
# FIREBASE PUSH NOTIFICATIONS
# ==========================================

# Path to Firebase service-account credentials JSON file.
# Used only for Firebase Cloud Messaging (FCM), not authentication.
FIREBASE_CREDENTIALS_PATH=

# ==========================================
# FAST2SMS PHONE OTP DELIVERY
# ==========================================

# Fast2SMS API key. Keep your actual key private.
FAST2SMS_API_KEY=

# Sender ID registered with Fast2SMS.
FAST2SMS_SENDER_ID=

# Fast2SMS message/template ID, if required by your account.
FAST2SMS_MESSAGE_ID=

# ==========================================
# EMAIL / SMTP SETTINGS
# ==========================================

# SMTP server address (provided by your email service).
SMTP_HOST=

# SMTP server port (587 is commonly used with TLS).
SMTP_PORT=587

# Email address shown as the sender.
SMTP_FROM_EMAIL=

# SMTP login username.
SMTP_USERNAME=

# SMTP login password or app password.
# Never commit your real password to GitHub.
SMTP_PASSWORD=

# Enable TLS encryption for SMTP.
SMTP_USE_TLS=true

# Enable SSL encryption instead of TLS when required.
SMTP_USE_SSL=false

# Maximum time to wait for the SMTP server (seconds).
SMTP_TIMEOUT_SECONDS=15

# ==========================================
# API SECURITY AND CORS
# ==========================================

# Allowed frontend origins, separated by commas.
# Configure your actual frontend domains for production.
CORS_ORIGINS=

# ==========================================
# LOGGING
# ==========================================

# INFO = normal application logs.
# DEBUG = detailed development logs.
LOG_LEVEL=INFO
